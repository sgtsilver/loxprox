# ═══════════════════════════════════════════════════════════════════════════════
# LoxProx — Deploy Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# This file holds all the values that used to live at the top of deploy.sh.
# Pulling them out of source code means upgrades (git pull + redeploy) no
# longer require re-editing the script every time.
#
# USAGE
# -----
#   First install:     sudo cp deploy.conf.example /etc/loxprox/deploy.conf
#                      sudo $EDITOR /etc/loxprox/deploy.conf
#                      sudo ./deploy.sh
#
#   Upgrading from v1.3.x or earlier without an /etc/loxprox/deploy.conf:
#                      sudo ./deploy.sh --bootstrap-config
#                      # Inspects live nftables / nginx / ip route, extracts
#                      # your current values, writes /etc/loxprox/deploy.conf,
#                      # asks you to confirm. Then run sudo ./deploy.sh normally.
#
#   Subsequent runs:   sudo ./deploy.sh
#                      # Sources /etc/loxprox/deploy.conf. If the file is
#                      # missing AND no live install is detected, it refuses
#                      # to run and tells you what to do.
#
# File location on the deployed VM:  /etc/loxprox/deploy.conf  (mode 0640 root)
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED — Network & Target Device
# ═══════════════════════════════════════════════════════════════════════════════

# [REQUIRED] Loxone Miniserver IP address
#   How to find: Run ./detect-loxone.sh on this machine, or check your router's
#   DHCP lease table for a device named "Loxone" or with MAC starting EE:E0:00
#   Example: "192.168.1.100"
LOXONE_IP="192.168.1.100"

# [REQUIRED] Loxone port (Gen 1 = 80, Gen 2 = usually 80 with HTTPS redirect)
#   This is the port the Miniserver listens on INSIDE your LAN.
#   Do NOT change this unless you reconfigured the Miniserver itself.
LOXONE_PORT="80"

# [REQUIRED] This gateway's static IP address
#   This VM must have a static IP so router port forwarding doesn't break.
#   Example: "192.168.1.50"
#   How to set: Run ./set-static-ip.sh BEFORE this script if needed.
GATEWAY_IP="192.168.1.50"

# [REQUIRED] Your LAN subnet (CIDR notation)
#   This is the network range that can reach SSH and is whitelisted in CrowdSec.
#   Example: "192.168.1.0/24"
#   How to find: ip route | grep default → check your interface's network mask
LAN_SUBNET="192.168.1.0/24"

# [REQUIRED] SSH allowed subnets (bash array — space-separated quoted CIDRs)
#   Only IPs from these networks can connect via SSH.
#   NEVER add 0.0.0.0/0 here — that exposes SSH to the entire internet.
#   Add your home LAN, a site-to-site VPN, and any jump boxes.
#   Example: ("192.168.1.0/24" "192.168.2.0/24" "10.8.0.0/24")
SSH_ALLOWED_SUBNETS=("192.168.1.0/24" "10.0.0.0/24")

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Rate Limiting (defaults are safe for home automation)
# ═══════════════════════════════════════════════════════════════════════════════

# Nginx rate limits — how many requests per second each IP can make
#   10 req/s with burst 100 is tuned for Loxone's web UI (it loads many assets).
#   Lower this if you see abuse; raise it if legitimate users get 503 errors.
RATE_LIMIT_REQ_PER_SEC="10"
RATE_LIMIT_BURST="100"

# Maximum concurrent connections per IP
#   20 is generous for a home setup. Prevents connection exhaustion attacks.
RATE_LIMIT_CONN_PER_IP="20"

# Proxy timeouts — how long nginx waits for the Miniserver to respond
#   These values protect against slowloris attacks (attackers hold connections
#   open to exhaust resources). Do not increase above 30s.
PROXY_CONNECT_TIMEOUT="10"
PROXY_SEND_TIMEOUT="15"
PROXY_READ_TIMEOUT="15"
CLIENT_BODY_TIMEOUT="10"
CLIENT_HEADER_TIMEOUT="10"

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — CrowdSec AppSec WAF
# ═══════════════════════════════════════════════════════════════════════════════

# Enable the CrowdSec AppSec Web Application Firewall
#   true  = Every HTTP request is inspected for CVE exploit patterns before
#           reaching the Loxone. Blocks known attack tools automatically.
#   false = Skip AppSec (not recommended).
ENABLE_APPSEC="true"

# AppSec operating mode
#   "monitor" — AppSec evaluates every rule and raises a CrowdSec alert on a
#               match, but never blocks (a local appsec-config carrying
#               default_remediation: allow). Check detections with
#               `cscli alerts list | grep appsec` — NOT
#               /var/log/nginx/appsec-detections.log, which nginx only
#               writes to on a BLOCK verdict and therefore stays empty here.
#               Use this for the first week to verify no false positives.
#   "enforce" — AppSec blocks matched requests with HTTP 403.
#               Use this after you're confident the rules work for your setup.
#   Switching modes: change the value and re-run ./deploy.sh (idempotent).
APPSEC_MODE="enforce"

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — CrowdSec Whitelist (IPs that can never be banned — NOT trusted)
# ═══════════════════════════════════════════════════════════════════════════════

# IPs and CIDR ranges that CrowdSec will NEVER block, even under attack.
#   Ban exemption only (since 2026-10-21): these sources still get the 403 on
#   the admin paths, the auth / WebSocket limits and the trap's 444. nginx
#   trusts only loopback, LAN_SUBNET and TRUSTED_SOURCES (below).
#   Add your home LAN, VPN networks and your household's WAN IP.
#   Leave out shared provider ranges (cloud, CDN, anycast): everyone sending
#   from them would be exempt from bans. A monitoring service that asks for
#   an app path under the host name is not banned and needs no entry.
#   Format: "1.2.3.4" for single IPs, "192.168.1.0/24" for ranges.
#   [strongly recommended for families] your household's public WAN IP.
#   Every phone, tablet and TV in the house shares it (and with CGNAT, so do
#   other households' devices). Without it, one misbehaving device can get
#   the whole family banned — and the progressive-ban escalation would then
#   extend that ban to 24h / 7d / 30d. Whitelisted addresses are exempt from
#   CrowdSec AND from progressive-ban escalation.
#   Find it with: curl -s https://ifconfig.me
CROWDSEC_WHITELIST_IPS=(
    "192.168.1.0/24"      # [REQUIRED] your local LAN
    "10.0.0.0/24"         # [optional] site-to-site / VPN network
    # "203.0.113.7"       # [recommended] household WAN IP
    # "203.0.113.45"      # [optional] your own uptime monitor, if it ever got banned
)

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Trusted sources (nginx trust besides LAN_SUBNET)
# ═══════════════════════════════════════════════════════════════════════════════

# Sources nginx trusts like the LAN: they reach the Miniserver's admin
#   webservices (REMOTE_ADMIN_PATHS) and the unknown paths (UNKNOWN_PATH_MODE),
#   and the per-endpoint limits (Loxone auth paths, /ws/ sockets) never count
#   them. Loopback and LAN_SUBNET are always trusted; most gateways need
#   nothing here. Typical entry: a second internal network or a site-to-site
#   VPN from which you run Loxone Config through the gateway.
#   Never list an address someone else can send from: a cloud, CDN or anycast
#   range, a monitoring or notification service, a CGNAT address.
#   Trusted is not "never banned": list a source in CROWDSEC_WHITELIST_IPS as
#   well if it must also never be banned.
#   deploy.sh refuses an entry wider than /24 (IPv6: /48) unless
#   TRUSTED_SOURCES_ALLOW_WIDE="true", and warns about every public entry.
#   Example: TRUSTED_SOURCES=("10.0.0.0/24")
TRUSTED_SOURCES=()
TRUSTED_SOURCES_ALLOW_WIDE="false"

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Alerting
# ═══════════════════════════════════════════════════════════════════════════════

# Discord webhook URL for real-time security alerts
#   Get a webhook URL from your Discord server:
#   1. Open Discord → Server Settings → Integrations → Webhooks
#   2. Create a webhook, copy the URL, paste it here.
#   3. Leave empty "" to disable Discord alerts entirely.
#   The script /opt/loxprox/discord-alert.sh uses this URL.
DISCORD_WEBHOOK_URL=""

# Email address for nginx error spike alerts (leave empty to skip)
#   Requires mailutils to be installed. Sends an email if nginx error log
#   grows by more than 100 lines in 15 minutes.
ALERT_EMAIL=""

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — TLS (HTTPS on the gateway via ACME / acme.sh)
# ═══════════════════════════════════════════════════════════════════════════════
#
# When enabled, deploy.sh installs acme.sh, requests a public certificate for
# TLS_DOMAIN via HTTP-01, installs it at /etc/loxprox/tls/, and switches the
# nginx :1080 listener from plain HTTP to HTTPS. Renewal runs via acme.sh's
# default cron (~daily) and reloads nginx automatically.
#
# Toggle anytime: edit `ENABLE_TLS`, re-run `sudo bash deploy.sh`. Off→on
# installs + mutates the site; on→off reverts the site mutation and disables
# the renewal cron. Cert files at /etc/loxprox/tls/ are kept so a later
# re-enable doesn't have to re-issue. Use `sudo bash deploy.sh --remove-tls`
# to fully nuke (cert files, acme.sh state, conf.d).
#
# Prerequisites (operator action, BEFORE setting ENABLE_TLS=true):
#   1. A public DNS A record pointing TLS_DOMAIN at your router's WAN IP.
#      (Dynamic DNS providers like selfhost.eu are fine — make sure the
#      hostname resolves before you flip the switch.)
#   2. A router port forward `WAN:80 → gateway:80` in addition to the
#      existing 1080 forward. The :80 listener on the gateway answers ONLY
#      `/.well-known/acme-challenge/` requests (everything else gets a 301
#      to https://$TLS_DOMAIN:1080$request_uri). The widened public surface
#      is just the challenge directory — same threat profile as any normal
#      Let's Encrypt setup.
#
# Host/SNI gate (2026-10): with TLS on, :1080 and :80 answer ONLY for
# TLS_DOMAIN and EXTRA_SERVER_NAMES. A request for any other name — and for
# the bare IP, which is how Shodan/Censys-style scanners connect — is logged to
# /var/log/nginx/loxprox-trap.log and answered with nothing (444); CrowdSec
# bans the address (loxprox/scanner-trap, HARD ladder). Every app and device
# must therefore use the host name, never the WAN IP. A device still on
# http://<name>:1080 keeps getting the 301 to https.
#
# Manual operations:
#   sudo bash deploy.sh --renew-tls    # force renewal now (acme.sh --renew)
#   sudo bash deploy.sh --remove-tls   # full removal — cert + state + cron
#

# Enable HTTPS on :1080. Default: false (plain HTTP).
ENABLE_TLS="false"

# Fully-qualified domain name the cert is issued for.
#   Must already resolve publicly to your router's WAN IP.
#   Example: "loxprox.example.com" (or your dynamic-DNS hostname)
TLS_DOMAIN=""

# Account email registered with the ACME provider. Required by Let's Encrypt;
# some providers (ZeroSSL) require it for account creation.
TLS_EMAIL=""

# ACME server. Accepts: letsencrypt, letsencrypt_test, zerossl, buypass,
# buypass_test, sslcom, or a full ACME directory URL.
#   - "letsencrypt"      → Let's Encrypt production (recommended)
#   - "letsencrypt_test" → Let's Encrypt staging (use during initial setup
#                          to avoid hitting rate limits while debugging)
#   - "zerossl"          → ZeroSSL production (default in upstream acme.sh)
TLS_ACME_SERVER="letsencrypt"

# v2.0 — Secondary CA tried automatically when the primary --issue fails
# (CA outage, rate limit). acme.sh registers the ZeroSSL account on the fly
# using TLS_EMAIL — no manual EAB credentials needed. Set to "" to disable.
TLS_ACME_FALLBACK_SERVER="zerossl"

# Extra arguments passed through to `acme.sh --issue`. Empty by default.
#   Examples:
#     "--keylength ec-256"       # request an ECDSA cert instead of RSA
#     "--debug"                  # noisy logs during issuance
#     "--days 60"                # custom renewal threshold
TLS_ACME_EXTRA=""

# Extra host names :1080 accepts in TLS mode besides TLS_DOMAIN (space-
# separated), e.g. a second DNS name for the same WAN IP. Not covered by the
# certificate unless you issue it for them (TLS_ACME_EXTRA="-d other.name").
# Ignored with TLS off (plain HTTP accepts every Host).
#   Example: "home.example.net"
EXTRA_SERVER_NAMES=""

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Tunnel (v2.0): zero-open-ports remote access via a relay VPS
# ═══════════════════════════════════════════════════════════════════════════════
#
# For connections where no port can be forwarded (CGNAT / DS-Lite). The
# gateway dials OUT to your own relay VPS (set up with
# tunnel-relay/install-relay.sh); the Loxone app connects to the relay's
# domain. No router configuration needed at all.
# Full runbook: docs/TUNNEL-SETUP.md
#
# NOTE: ENABLE_TUNNEL=true and ENABLE_TLS=true are mutually exclusive in
# v2.0 — with the tunnel, TLS terminates at the relay.
#
# Manual operations:
#   sudo bash deploy.sh --remove-tunnel   # full removal — binary, config, units
#

# Enable the frp tunnel. Default: false (classic router port-forward path).
ENABLE_TUNNEL="false"

# [REQUIRED if enabled] Relay VPS public IP or DNS name (the frps host).
TUNNEL_SERVER_ADDR=""

# frp control-channel port on the relay. Must match FRP_BIND_PORT there.
# The relay listens on this port number for BOTH tcp and quic (udp).
TUNNEL_SERVER_PORT="7000"

# Tunnel transport: "quic" (UDP; NAT-friendly, connection migration —
# recommended) or "tcp" (fallback for networks that drop UDP).
TUNNEL_PROTOCOL="quic"

# [REQUIRED if enabled] Shared tunnel secret — SAME value as TUNNEL_TOKEN in
# the relay's /etc/loxprox-relay/relay.conf. Generate: openssl rand -hex 32
TUNNEL_TOKEN=""

# Proxy name inside frp (cosmetic, shows up in frps logs).
TUNNEL_PROXY_NAME="loxone"

# Loopback-bound port on the relay that carries tunneled traffic to its
# nginx. Must match TUNNEL_REMOTE_PORT in the relay's relay.conf.
TUNNEL_REMOTE_PORT="8443"

# Public domain served by the relay (its RELAY_DOMAIN). Used by the tunnel
# watchdog for full-path health probes and printed in the deploy summary.
TUNNEL_PUBLIC_HOST=""

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — LoxProx Panel (GUI) (v2.1)
# ═══════════════════════════════════════════════════════════════════════════════
#
# A small web panel on the gateway itself: QR-code invitation for family
# members, service/cert/ban status at a glance, and an editor for the
# non-lockout config keys with one-click apply (re-runs deploy.sh).
# Full runbook: docs/GUI-PANEL.md
#
# The panel is LAN-only by construction — deploy.sh writes an nftables rule
# that accepts GUI_PORT ONLY from LAN_SUBNET and SSH_ALLOWED_SUBNETS, and the
# panel additionally rejects requests whose Host header is not the gateway
# (anti DNS-rebinding). Never forward GUI_PORT on your router.
#
# Toggle anytime: edit ENABLE_GUI, re-run `sudo bash deploy.sh`. Off removes
# the service and the firewall rule.
#

# LAN-only web panel with family QR invitation, status, config editing;
# never internet-reachable — nftables only accepts LAN_SUBNET +
# SSH_ALLOWED_SUBNETS sources; set "false" to remove.
ENABLE_GUI="true"

# TCP port the panel listens on. Must not collide with 22, 80 or 1080.
GUI_PORT="1081"

# Empty = no password; if set, panel mutations — unban/restart/config/apply —
# require it; recommended when untrusted devices share the LAN.
GUI_PASSWORD=""

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Edge filtering, ban ladders, alerts (2026-10 breach hardening)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Every request on :1080 falls into one path class:
#   trap    scanner-only paths (/.env, /.git, *.php, /wp-*, /cgi-bin/, …) and
#           the methods CONNECT/TRACE/TRACK/PROPFIND → 444 + trap log; the
#           address is banned on the first hit (HARD ladder).
#   admin   Loxone file-system / system-control webservices (fsget, fslist,
#           fsdel, sys/reboot, sps/restart, cfg setters, …) → REMOTE_ADMIN_PATHS.
#   app     the endpoints the Loxone app uses → proxied as always.
#   unknown everything else → UNKNOWN_PATH_MODE.
# LAN_SUBNET and TRUSTED_SOURCES are never denied (admin/unknown) and
# never counted by the per-endpoint limits (Loxone auth paths: 3/s, burst 30;
# /ws/: 6 concurrent sockets per address); CROWDSEC_WHITELIST_IPS is not
# exempt (never banned only). The trap applies to everyone.

# "log" (default) = unknown paths are proxied AND written to
#   /var/log/nginx/loxprox-unknown.log — the learning phase: watch that log
#   for paths the app really uses. The loxprox/unknown-path scenario only
#   alerts (CrowdSec simulation) in this mode.
# "deny" = unknown paths from the internet get a local 404 (still logged),
#   and loxprox/unknown-path bans (SOFT ladder).
UNKNOWN_PATH_MODE="log"

# "deny" (default) = Loxone admin / file-system webservices answer 403 to
#   internet clients (logged; never banned by a LoxProx scenario, but repeated
#   403s still count toward crowdsecurity/http-probing). "allow" = proxied like
#   any app path.
REMOTE_ADMIN_PATHS="deny"

# What a trap hit costs the client. The trap itself (444 + trap log) works
# from the first request in both modes; this only decides the CrowdSec ban.
# "ban" (default) = loxprox/scanner-trap bans on the first hit (HARD ladder).
# "observe" = it only alerts (CrowdSec simulation) — use it for the first
#   ~48 h after enabling the Host/SNI gate, to see whether one of your own
#   devices lands in the trap (e.g. an app configured with the WAN IP).
# Rollout:
#   1. TRAP_BAN_MODE="observe", sudo bash deploy.sh
#   2. after ~48 h: sudo cscli alerts list -s loxprox/scanner-trap --limit 0
#      and /var/log/nginx/loxprox-trap-hosts.log — any of your own devices in
#      there? That log (TLS only, not read by CrowdSec) shows per trap hit the
#      Host and SNI the client asked for: host= an old or other real name, or
#      your WAN IP / a CloudDNS address, with the Loxone app's user agent at
#      the end of the line, is one of yours; a bare IP with a scanner's user
#      agent is not. Fix your devices (the real host name instead of an IP) first.
#   3. TRAP_BAN_MODE="ban" here, then EITHER re-run sudo bash deploy.sh
#      OR sudo cscli simulation disable loxprox/scanner-trap && sudo systemctl reload crowdsec
#      — change this file either way: with "observe" left here, the next
#      deploy (or a panel apply) puts the trap back into observe mode.
TRAP_BAN_MODE="ban"

# Sources exempt from the trap and from every ban — for a known service that
# probes the bare IP, e.g. a vendor cloud probe sending plain HTTP to :1080
# once a day. Exempt is NOT trusted: unlike TRUSTED_SOURCES these sources
# keep the rate limits, the admin/unknown denials and the trap's 444.
# What changes for them: they are never written to the trap logs, CrowdSec
# never alerts on or bans them (whitelist loxprox/trap-exempt in
# /etc/crowdsec/parsers/s02-enrich/whitelist-loxprox-trap-exempt.yaml), and
# their cleartext request to :1080 with a foreign Host gets the real server's
# 301 instead of the 444 (TLS mode), exactly as before the trap: to
# https://<the Host they sent>:1080, never to TLS_DOMAIN. Addresses or
# CIDRs (IPv4/IPv6); an entry that is trusted (loopback, LAN_SUBNET,
# TRUSTED_SOURCES) or overlaps CROWDSEC_WHITELIST_IPS is refused. Empty (default) = nobody;
# the deploy then removes the whitelist file — also a hand-made one.
#   Example: TRAP_EXEMPT_IPS=("203.0.113.10" "2001:db8:10::/48")
TRAP_EXEMPT_IPS=()

# Ban durations per offence, as CrowdSec durations (m/h/d). HARD applies to
# unambiguous scanner scenarios (BAN_HARD_SCENARIOS), SOFT to everything else.
# The first value is the ban CrowdSec issues (deploy.sh writes it into
# /etc/crowdsec/profiles.yaml); progressive-ban.py extends repeat offenders to
# the next value, the last one repeating.
BAN_HARD_LADDER="168h 2160h 8760h"        # 7 days → 90 days → 1 year
BAN_SOFT_LADDER="24h 168h 720h 2160h"     # 1 day → 7 → 30 → 90 days

# Scenario names that use the HARD ladder — one regular expression, valid in
# both Go RE2 (CrowdSec) and Python (progressive-ban.py): no lookarounds, no
# quotes, no backslashes. Leave it commented to keep the shipped default:
# BAN_HARD_SCENARIOS='^(loxprox/scanner-trap|crowdsecurity/(appsec-vpatch|vpatch-.+|http-cve-.+|CVE-.+|[A-Za-z0-9_]+-cve-.+|http-sensitive-files|http-backdoors-attempts|http-path-traversal-probing|http-admin-interface-probing|http-open-proxy))$'

# How long an offence is remembered for the ladder, in days. CrowdSec keeps
# its alert history at least this long + 35 days (config.yaml.local, ≥ 400d).
PROGRESSIVE_BAN_WINDOW_DAYS="365"

# Discord alert when a remote session comes from an ASN (provider network) the
# gateway has not seen before. The first ASN_LEARNING_DAYS days only learn.
SESSION_ALERT_ENABLED="true"
ASN_LEARNING_DAYS="7"

# Alert when more Loxone auth requests than this reach the gateway in one
# monitor cycle (60 s), all clients together — a credential-stuffing signal.
# The normal level is a handful per DAY (0–5), so 20 in one minute is loud.
AUTH_RATE_ALERT_PER_CYCLE="20"

# Alert when a pending Debian security update has not been installed after
# this many days (unattended-upgrades stuck or misconfigured).
SEC_UPDATE_MAX_AGE_DAYS="2"

# GeoIP country denylist for IPv6 as well (same countries as IPv4).
# GEOIP_URL_BASE6: empty = the ipdeny.com IPv6 lists.
GEOIP_IPV6_ENABLED="true"
GEOIP_URL_BASE6=""

# SSH: space-separated AllowUsers patterns (user or user@host). Empty = no
# AllowUsers line (every account with a key may log in). deploy.sh refuses
# to write a list that would lock everyone out (no listed account exists,
# or — key-only mode — none has an authorized key).
#   Example: "admin"
SSH_ALLOW_USERS=""

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Maintenance
# ═══════════════════════════════════════════════════════════════════════════════

# Time for automatic reboot after kernel security updates
#   Format: 24-hour clock, local time.
#   Example: "03:00" = 3 AM. Set to a time when no one uses the Loxone.
AUTOREBOOT_TIME="03:00"

# AppArmor mode for the shipped nginx profile (apparmor/usr.sbin.nginx).
#   "complain" (default): profile loaded, violations logged, nothing blocked —
#     the soak phase. Watch `aa-status` and `journalctl -g apparmor` for
#     ALLOWED events before even thinking about enforce.
#   "enforce": only after a multi-week complain soak that covered at least one
#     ~60-day acme.sh certificate renewal and one full deploy run. See
#     docs/adr/0006. deploy.sh never enforces on its own.
APPARMOR_NGINX_MODE="complain"
