# LoxProx — AppArmor profile for nginx (Debian 12)
#
# Installed by deploy.sh:setup_apparmor() to /etc/apparmor.d/usr.sbin.nginx.
# Debian ships no nginx profile, so this is authored for exactly the gateway's
# nginx surface: reverse proxy on :1080 (TLS) + ACME listener on :80,
# CrowdSec AppSec auth_request to 127.0.0.1:7422, logrotate USR1 log reopen,
# acme.sh-renewed certificates under /etc/loxprox/tls/ (read-only here —
# acme.sh itself runs unconfined and writes them).
#
# MODE: loaded in COMPLAIN mode by default (aa-complain via deploy.sh).
# Enforcement is gated on APPARMOR_NGINX_MODE="enforce" in deploy.conf and
# waits for a multi-week complain soak that covers at least one ~60-day
# acme.sh renewal and one full deploy run. See docs/adr/0006.
#
# Containment intent: a compromised nginx must NOT read /etc/loxprox/
# outside tls/ (deploy.conf holds the Discord webhook + panel password),
# must not touch /opt/loxprox/, and must not execute anything other than
# re-executing its own binary (the in-place binary upgrade), which stays
# inside this profile (ix).
#
# 2026-10: the complain soak logged ~58 ALLOWED events per nginx start/reload
# on a Debian 12 nginx-extras box, all from paths below that the original
# profile missed — the dynamic lua and perl modules initialising, a NUMA
# memory probe, and the binary-upgrade pid/exec dance. They are allowed now;
# each would have been a denial in enforce mode.

#include <tunables/global>

/usr/sbin/nginx {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  #include <abstractions/ssl_certs>

  capability chown,
  capability dac_override,
  capability kill,
  capability net_bind_service,
  capability setgid,
  capability setuid,

  # master <-> worker signalling; systemd/logrotate signal the master
  signal (send, receive) peer=/usr/sbin/nginx,
  signal (receive) peer=unconfined,

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  network netlink raw,

  # ix: binary upgrade (USR2 / Debian's package-upgrade "upgrade" action)
  # makes the master execve() /usr/sbin/nginx; the new master inherits this
  # profile instead of escaping it.
  /usr/sbin/nginx mrix,
  /usr/lib/nginx/modules/ r,
  /usr/lib/nginx/modules/*.so mr,

  # nginx-extras loads libnginx-mod-http-lua, which pulls lua-resty-core
  # (resty/core.lua, resty/core/*.lua, resty/lrucache.lua) at init even with
  # no lua directive configured. Read-only distro library code.
  /usr/share/lua/** r,

  # ...and libnginx-mod-http-perl, whose embedded interpreter loads nginx.pm,
  # which pulls its pragmas (strict, warnings, warnings/register, constant,
  # Exporter, XSLoader) from /usr/share/perl/<version>/. Version-agnostic
  # glob: survives a Debian release bump of the perl version. Read-only.
  /usr/share/perl/** r,

  # NUMA topology probe at start (node list + per-node meminfo).
  /sys/devices/system/node/ r,
  /sys/devices/system/node/node[0-9]*/meminfo r,

  # configuration (read-only)
  /etc/nginx/ r,
  /etc/nginx/** r,
  /usr/share/nginx/ r,
  /usr/share/nginx/** r,

  # GeoIP databases for the geoip/geoip2 dynamic modules
  /usr/share/GeoIP/ r,
  /usr/share/GeoIP/** r,

  # TLS material — READ ONLY by design (acme.sh writes renewals, unconfined)
  /etc/loxprox/tls/ r,
  /etc/loxprox/tls/** r,

  # ACME HTTP-01 webroot (deploy.sh + acme.sh stage challenges here)
  /var/www/acme/ r,
  /var/www/acme/** r,

  # logs — created/reopened on logrotate's USR1
  /var/log/nginx/ r,
  /var/log/nginx/** w,

  # runtime state
  /run/nginx.pid rw,
  # Binary upgrade: the old master renames nginx.pid to nginx.pid.oldbin and
  # unlinks it when it exits (rename back on a rolled-back upgrade).
  /run/nginx.pid.oldbin rw,
  /var/lib/nginx/ r,
  /var/lib/nginx/** rw,
}
